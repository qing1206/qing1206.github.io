// Bliss 页面样式
// 主要容器
.bliss-container
  max-width 1000px
  margin 2rem auto
  padding 1rem
  
  &.timeline-view
    .bliss-records
      display flex
      flex-direction column
      
  &.calendar-view
    .bliss-records
      display grid
      grid-template-columns repeat(auto-fill, minmax(200px, 1fr))
      gap 1.5rem
      
  &.grid-view
    .bliss-records
      display grid
      grid-template-columns repeat(auto-fill, minmax(280px, 1fr))
      gap 2rem

// 页面标题区
.bliss-header
  margin-bottom 2rem
  text-align center
  
  h1
    font-size 2.4rem
    margin-bottom 1rem
    font-weight normal
  
  p
    color #666
    font-size 1rem
    max-width 600px
    margin 0 auto

// 控制区域
.bliss-controls
  background #f9f9f9
  border-radius 10px
  padding 1.2rem
  margin-bottom 2rem
  box-shadow 0 2px 8px rgba(0, 0, 0, 0.05)
  
  h3
    margin-top 0
    margin-bottom 0.8rem
    font-size 1.1rem
    font-weight normal
    color #555
  
  .control-group
    margin-bottom 1rem
    
    &:last-child
      margin-bottom 0
    
    label
      display block
      margin-bottom 0.5rem
      font-size 0.9rem
      color #666

// 筛选按钮组
.filter-buttons
  display flex
  flex-wrap wrap
  gap 0.5rem
  
  button
    background white
    border 1px solid #ddd
    padding 0.5rem 1rem
    border-radius 20px
    font-size 0.9rem
    cursor pointer
    transition all 0.2s ease
    
    &:hover
      background #f0f0f0
    
    &.active
      background #6c5ce7
      color white
      border-color #6c5ce7

// 视图切换
.view-toggle
  display flex
  gap 0.5rem
  
  button
    background white
    border 1px solid #ddd
    padding 0.5rem 1rem
    border-radius 20px
    font-size 0.9rem
    cursor pointer
    transition all 0.2s ease
    
    &:hover
      background #f0f0f0
    
    &.active
      background #6c5ce7
      color white
      border-color #6c5ce7

// 记录卡片
.bliss-record
  background white
  border-radius 12px
  padding 1.2rem
  box-shadow 0 2px 12px rgba(0, 0, 0, 0.08)
  cursor pointer
  position relative
  transition all 0.3s ease
  
  &:hover
    transform translateY(-3px)
    box-shadow 0 5px 15px rgba(0, 0, 0, 0.1)
  
  .record-date
    color #6c5ce7
    font-size 1rem
    margin-bottom 0.5rem
    font-weight 500
  
  .record-type
    display inline-block
    font-size 0.8rem
    padding 0.3rem 0.8rem
    border-radius 20px
    margin-right 0.5rem
    margin-bottom 0.5rem
    
    &.penetrative
      background #ffeaa7
      color #d6a500
    
    &.oral
      background #81ecec
      color #00a1a1
    
    &.caress
      background #fab1a0
      color #e17055
    
    &.other
      background #dfe6e9
      color #636e72
  
  .record-position
    display inline-block
    font-size 0.8rem
    padding 0.3rem 0.8rem
    border-radius 20px
    background #e6e6fa
    color #6c5ce7
    margin-bottom 0.5rem
  
  .record-notes
    margin-top 1rem
    font-size 0.95rem
    color #555
    position relative
    overflow hidden
    max-height 0
    transition max-height 0.3s ease
  
  &.expanded
    .record-notes
      max-height 200px
      margin-top 1rem
    
    &:after
      transform rotate(180deg)
  
  &:after
    content "↓"
    position absolute
    right 1.2rem
    top 1.2rem
    color #6c5ce7
    transition transform 0.3s ease

// 空状态
.empty-state
  text-align center
  padding 3rem 1rem
  color #888
  
  p
    font-size 1.1rem
    margin-bottom 1rem
  
  .emoji
    font-size 3rem
    margin-bottom 1rem

// 日期分割
.date-separator
  margin 2rem 0
  text-align center
  position relative
  
  &:before
    content ""
    position absolute
    left 0
    top 50%
    width 100%
    height 1px
    background #e0e0e0
    z-index 1
  
  span
    background white
    padding 0 1rem
    position relative
    z-index 2
    color #888
    font-size 0.9rem

// 适配手机
@media (max-width: 768px)
  .bliss-container
    padding 0.8rem
    
    &.calendar-view,
    &.grid-view
      .bliss-records
        grid-template-columns repeat(auto-fill, minmax(140px, 1fr))
  
  .bliss-record
    padding 1rem
    
    .record-date
      font-size 0.9rem
    
    &:after
      top 1rem
      right 1rem