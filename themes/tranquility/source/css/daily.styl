@import "_variables"

.daily-container
  max-width: 900px
  margin: 0 auto
  padding: 3rem 1rem
  
.daily-header
  text-align: center
  margin-bottom: 4rem
  
  .daily-title
    font-size: 2.5rem
    margin-bottom: 1rem
    font-weight: 700
    // 移除颜色设置，恢复默认颜色
    letter-spacing: 1px
    
  .daily-description
    color: $color-meta
    font-size: 1.1rem
    max-width: 600px
    margin: 0 auto
    line-height: 1.6
    margin-bottom: 1.5rem
    
  // 添加排序控制按钮样式
  .daily-sort-control
    margin-top: 1.5rem
    
    .daily-sort-btn
      background-color: #fff
      border: 1px solid rgba(0, 0, 0, 0.1)
      border-radius: 30px
      padding: 8px 20px
      color: $color-primary
      font-size: 0.95rem
      cursor: pointer
      transition: all 0.3s ease
      display: inline-flex
      align-items: center
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05)
      
      &:hover
        background-color: $color-primary-light
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.1)
        
      .sort-text
        margin-right: 5px
        color: $color-meta
        font-weight: normal
        
      .sort-desc, .sort-asc
        font-weight: 500
        transition: opacity 0.3s ease, transform 0.3s ease
      
      .sort-desc
        opacity: 0
        position: absolute
        transform: translateY(10px)
      
      .sort-asc
        opacity: 0
        position: absolute
        transform: translateY(10px)
      
      .sort-icon
        margin-left: 6px
        font-size: 0.9em
        transition: transform 0.3s ease
      
      // 根据当前排序方式显示对应文本
      &.desc
        .sort-desc
          opacity: 1
          position: relative
          transform: translateY(0)
        
        .sort-asc
          opacity: 0
          position: absolute
          transform: translateY(10px)
      
      &.asc
        .sort-desc
          opacity: 0
          position: absolute
          transform: translateY(10px)
        
        .sort-asc
          opacity: 1
          position: relative
          transform: translateY(0)
          
        .sort-icon
          transform: rotate(180deg)

.daily-timeline
  position: relative
  
  &:before
    content: ''
    position: absolute
    left: 0
    top: 0
    bottom: 0
    width: 3px
    background-color: rgba(0, 0, 0, 0.08)
    margin-left: 7px
    z-index: 0
    
    @media (min-width: 768px)
      left: 50%
      margin-left: -1.5px

.daily-item
  position: relative
  margin-bottom: 9rem
  padding-left: 30px
  clear: both
  overflow: visible
  
  @media (min-width: 768px)
    padding-left: 0
    margin-bottom: 10rem
    
  &:before
    content: ''
    position: absolute
    left: 0
    top: 22px
    width: 16px
    height: 16px
    border-radius: 50%
    background-color: $color-primary
    z-index: 3
    box-shadow: 0 0 0 4px #fff, 0 0 0 8px $color-primary-light
    transition: transform 0.3s ease, background-color 0.3s ease
    
    @media (min-width: 768px)
      left: 50%
      margin-left: -8px
      top: 35px
      
  &:hover:before
    transform: scale(1.1)
    background-color: $color-primary-dark
      
  &:after
    content: none
      
  .daily-item__meta
    margin-bottom: 1.5rem
    position: relative
    padding-top: 20px
    
    @media (min-width: 768px)
      width: 38%
      text-align: right
      padding-right: 60px
      float: left
      margin-top: 10px
      
  .daily-item__date
    font-weight: bold
    color: $color-primary
    font-size: 1.4rem  // 从 1.3rem 增加到 1.4rem
    position: relative
    letter-spacing: 0.5px
    
  .daily-item__time
    font-size: 1.05rem  // 从 0.95rem 增加到 1.05rem
    color: $color-meta
    margin-top: 5px
    
  .daily-item__content
    background-color: #fff
    border-radius: 18px
    padding: 28px 32px
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04), 0 2px 6px rgba(0, 0, 0, 0.04)
    position: relative
    margin-top: 10px
    z-index: 1
    
    @media (min-width: 768px)
      width: 38%
      float: right
      margin-top: 0
      padding: 30px 35px
      
      &:before
        content: ''
        position: absolute
        left: -15px
        top: 35px
        width: 0
        height: 0
        border-top: 12px solid transparent
        border-bottom: 12px solid transparent
        border-right: 15px solid #fff
        z-index: 2
        filter: drop-shadow(-3px 2px 2px rgba(0, 0, 0, 0.05))
        
  .daily-item__image
    margin-bottom: 1.5rem
    border-radius: 12px
    overflow: hidden
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08)
    
    img
      max-width: 100%
      height: auto
      display: block
      transition: transform 0.4s ease
      cursor: pointer
      
      &:hover
        transform: scale(1.03)
        
  .daily-item__text
    line-height: 1.7
    margin-bottom: 1.2rem
    font-size: 1.05rem
    color: #333
    
  .daily-item__mood
    font-size: 0.9rem
    color: $color-primary
    display: inline-block
    padding: 5px 14px
    background: $mood-bg
    border-radius: 20px
    margin-top: 8px
    letter-spacing: 0.5px

  &:nth-child(even)
    @media (min-width: 768px)
      .daily-item__meta
        float: right
        text-align: left
        padding-right: 0
        padding-left: 60px
        
      .daily-item__content
        float: left
        padding: 30px 35px
        
        &:before
          left: auto
          right: -15px
          border-left: 15px solid #fff
          border-right: none
          filter: drop-shadow(3px 2px 2px rgba(0, 0, 0, 0.05))

.daily-month-divider
  text-align: center
  margin: 8rem 0 4rem
  position: relative
  clear: both
  z-index: 2
  padding-top: 2rem
  
  &:before
    content: ''
    position: absolute
    top: 50%
    left: 0
    right: 0
    height: 1px
    background-color: rgba(0, 0, 0, 0.1)
  
  span
    display: inline-block
    background-color: #fff
    padding: 0.8rem 2.5rem
    position: relative
    color: $color-primary
    font-weight: bold
    font-size: 1.4rem
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05)
    border-radius: 30px

.daily-month-divider:first-child
  margin-top: 4rem
  margin-bottom: 3rem

.daily-empty
  text-align: center
  padding: 4rem 0
  color: $color-meta
  font-size: 1.1rem

.back-to-top
  position: fixed
  right: 30px
  bottom: 30px
  width: 45px
  height: 45px
  border-radius: 50%
  background-color: $color-primary
  color: #fff
  text-align: center
  line-height: 45px
  cursor: pointer
  opacity: 0
  transition: opacity 0.3s ease, transform 0.3s ease
  z-index: 99
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15)
  font-size: 1.2rem
  
  &.visible
    opacity: 0.8
    
  &:hover
    opacity: 1
    transform: translateY(-3px)

@media (max-width: 767px)
  .daily-timeline
    padding-left: 20px
    
    &:before
      width: 3px
    
  .daily-item
    margin-bottom: 7rem
    
    &:before
      top: 18px
      left: -10px
      width: 14px
      height: 14px
      box-shadow: 0 0 0 3px #fff, 0 0 0 6px $color-primary-light
    
  .daily-item__meta
    padding-top: 15px
    
  .daily-item__content
    margin-left: 20px
    padding: 22px 28px
    
    &:before
      content: ''
      position: absolute
      left: -12px
      top: 18px
      width: 0
      height: 0
      border-top: 10px solid transparent
      border-bottom: 10px solid transparent
      border-right: 12px solid #fff
      filter: drop-shadow(-2px 1px 1px rgba(0, 0, 0, 0.05))
    
  .daily-month-divider
    margin: 6rem 0 3rem
    
  .daily-month-divider span
    font-size: 1.1rem
    padding: 0.5rem 1.5rem

  .daily-month-divider:first-child
    margin-top: 3rem
    margin-bottom: 2.5rem

@keyframes fadeInUp
  from
    opacity: 0
    transform: translateY(20px)
  to
    opacity: 1
    transform: translateY(0)

.daily-item
  animation: fadeInUp 0.6s ease-out
  animation-fill-mode: both

/* 图片灯箱样式覆盖 */
.lg-backdrop
  background-color: rgba(0, 0, 0, 0.85)

.lg-toolbar,
.lg-outer
  background-color: transparent

.lg-toolbar .lg-icon:hover,
.lg-actions .lg-next:hover, 
.lg-actions .lg-prev:hover
  color: $color-primary
